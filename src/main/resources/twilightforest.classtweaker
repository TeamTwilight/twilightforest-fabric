classTweaker v2 official

# Comment each CT with where it needed to be used and why

# Sets Custom Display Component for container UI
accessible field net/minecraft/world/level/block/entity/BaseContainerBlockEntity name Lnet/minecraft/network/chat/Component;

# BiomeGrassColors and FoliageColorHandler (gets biome noise values for blending colors together)
